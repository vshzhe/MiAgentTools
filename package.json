{
  "name": "mi-agent-tools",
  "version": "2.0.0",
  "description": "AI Agent 技能生成与管理 CLI —— 按技能类型（init/impl/test/commit/review/release/tools/docs/spec）生成 iagent_ 前缀的 SKILL 与指令",
  "keywords": [
    "iagent",
    "agent-tools",
    "skills",
    "cli",
    "claude-code",
    "ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vshzhe/MiAgentTools.git"
  },
  "homepage": "https://github.com/vshzhe/MiAgentTools#readme",
  "bugs": {
    "url": "https://github.com/vshzhe/MiAgentTools/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "bin": {
    "iagent": "./bin/iagent.js"
  },
  "files": [
    "dist",
    "bin",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/__tests__",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "node build.js",
    "lint": "eslint src/ test/",
    "dev": "tsc --watch",
    "dev:cli": "pnpm build && node bin/iagent.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:skills": "node scripts/generate-skills.mjs",
    "prepare": "node build.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "commander": "^14.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
