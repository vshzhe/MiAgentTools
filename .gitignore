# ── 依赖与构建产物（均不入库）────────────────────────────────────
node_modules/
dist/
*.tsbuildinfo
.eslintcache
coverage/
.nyc_output/

# ── CI 工作流（仅本机保留，不入库、不推送）───────────────────────
# .github/workflows/ 下的工作流文件保留在本机供本地调试，推送时排除；
# 已入库的文件须用 `git rm -r --cached .github/workflows` 解除跟踪。
.github/workflows/

# ── iagent 本机产物与索引（均不入库）─────────────────────────────
# .iagent/ = 本项目配置（config.yaml + rules/ + scan-baseline.json + pi-runtime.json），
# .claude/ .pi/ .codex/ .opencode/ = dogfood 产物（iagent init / update 生成）。
# 均为本机状态而非仓库分发内容；模板的提交源是 skills/ 静态快照，
# 本机刷新用 `pnpm generate:skills`（快照）与 `iagent update`（dogfood 产物）。
.iagent/
.claude/
.pi/
.codex/
.opencode/
.codegraph/

# ── openspec：仅纳管提案制品（openspec/changes/**），其余保持本机状态 ──
# 规则链（MUST 按此形态，否则放行无效）：先通配排除 openspec/ 的直接子项，
# 再放行 changes/，最后逐个排除缓存目录。git 语义下「父目录被排除时无法用
# `!` 重新纳入子路径」，故 MUST NOT 写成 `openspec/` + `!openspec/changes/**`。
# 保持忽略（不纳管）：openspec/explorations/**、openspec/specs/**、
# openspec/devdocs/**、openspec/rules/**、openspec/config.yaml、openspec/CONTEXT.md
# —— 均被 `openspec/*` 覆盖。
openspec/*
!openspec/changes/
openspec/changes/archive/.iagent/
openspec/changes/**/attachments/
# ADR（决策记录）随仓库走：仅放行 openspec/docs/adr/，其余 openspec/docs/** 仍忽略
!openspec/docs/
openspec/docs/*
!openspec/docs/adr/
.openspec-tmp/

# ── 运行 / 发布临时产物 ─────────────────────────────────────────
# npm pack / pnpm pack 打出的包（发布前自检用 --dry-run 不落盘）
*.tgz
# gentest-java 运行临时工作区（本机生成，不入库）
iagent_java_unit_test-workspace/
# 补丁与合并残留
*.orig
*.rej

# ── 日志 ────────────────────────────────────────────────────────
*.log

# ── 本机环境变量（.env.example 若引入则应入库）───────────────────
.env
.env.*
!.env.example

# ── 编辑器与系统文件（预防性条目，当前仓库中均不存在）────────────
.DS_Store
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
*.iml
